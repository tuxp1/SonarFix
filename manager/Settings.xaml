<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SonarFix" Width="760" SizeToContent="Height" MinWidth="560" MinHeight="420" Background="#10151F" Foreground="#EDF2FA" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#AAB8CD"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Background" Value="#253349"/><Setter Property="Foreground" Value="#F6F8FC"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
<Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="Margin" Value="0,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="19" Height="19" CornerRadius="4" Background="#10151F" BorderBrush="#73859F" BorderThickness="1.5" VerticalAlignment="Center"><Path x:Name="Tick" FlowDirection="LeftToRight" Data="M 3,8 L 6,11 L 12,4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="#267B71"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Feature" TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,4,12,4"/><Border Grid.Column="1" x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#46536A" BorderThickness="1" BorderBrush="#73859F" FlowDirection="LeftToRight"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#267B71"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#1A2230"/><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="BorderBrush" Value="#52637D"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="Background" Value="#1A2230"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#31465A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#245C58"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="Background" Value="#10151F"/><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Drop" Foreground="{TemplateBinding Foreground}" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="#10151F" BorderBrush="#52637D" BorderThickness="1" CornerRadius="6"><DockPanel Margin="11,7"><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="10,0,0,0" Foreground="#AAB8CD"/><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#71D6C8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1A2230" BorderBrush="#52637D" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Drop" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Collapsible" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAB8CD"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,4"/></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,8,3"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#3D2229"/><Setter Property="Foreground" Value="#F2A9B2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="MinWidth" Value="170"/></Style>
  <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="11,0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="MinWidth" Value="38"/></Style>
  <Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#2E3A4C" CornerRadius="3" Margin="1,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#52637D"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#71D6C8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="MinWidth" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="22"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="#AAB8CD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="HeaderToggle" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Foreground="{TemplateBinding Foreground}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="4,5" Background="Transparent"><DockPanel><TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="›" Margin="0,0,8,0" Foreground="#71D6C8"/><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#71D6C8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#1A2230"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="AdvancedBody" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="AdvancedBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EDF2FA"/><Setter Property="Background" Value="#17202D"/><Setter Property="BorderBrush" Value="#52637D"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#71D6C8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
 <DockPanel x:Name="Shell" Margin="22,16,22,14" MaxWidth="760" Focusable="False">
  <Border DockPanel.Dock="Bottom" BorderBrush="#303A4A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0"><StackPanel><TextBlock x:Name="Feedback" Foreground="#71D6C8" Margin="0,0,0,4" Style="{StaticResource Collapsible}"/><WrapPanel><Button x:Name="Save" IsDefault="True" Background="#267B71" FontWeight="SemiBold" Padding="17,9"/><Button x:Name="Stop" Padding="17,9"/></WrapPanel></StackPanel></Border>
  <Button x:Name="LanguageToggle" DockPanel.Dock="Top" HorizontalAlignment="Right" Padding="5,2" Margin="0,0,0,8" Background="Transparent"/>
  <ScrollViewer x:Name="MainScroll" Focusable="False" IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Root" Focusable="False" Margin="0,0,4,0">
    <Border Background="#172D32" BorderBrush="#315D5C" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10"><DockPanel><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusTitle" FontWeight="SemiBold"/><TextBlock x:Name="Status" Foreground="#C0DDD8" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
    <Border Background="#1A2230" CornerRadius="8" Padding="16,12" Margin="0,0,0,10"><StackPanel><CheckBox x:Name="Echo" Style="{StaticResource Feature}"/><TextBlock x:Name="EchoDescription" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
    <Border Background="#1A2230" CornerRadius="8" Padding="16,12" Margin="0,0,0,10"><StackPanel><CheckBox x:Name="Disable" Style="{StaticResource Feature}"/><TextBlock x:Name="DisableDescription" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/><TextBlock x:Name="DeviceStatus" Foreground="#71D6C8" FontSize="13" Margin="0,6,0,0"/><StackPanel x:Name="OutputSettings" Margin="0,12,0,0"><TextBlock x:Name="OutputLabel" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/><ComboBox x:Name="Output" FlowDirection="LeftToRight"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox x:Name="Redirect" Margin="0,10,0,0"/></StackPanel></StackPanel></Border>
    <Expander x:Name="Advanced" HorizontalContentAlignment="Stretch"><StackPanel Margin="4,0,0,4">
     <TextBlock x:Name="StartupSection" Style="{StaticResource Section}"/><CheckBox x:Name="Startup" Margin="0,3"/><CheckBox x:Name="ShowTray" Margin="0,3"/>
     <TextBlock x:Name="MaintenanceSection" Style="{StaticResource Section}"/>
     <UniformGrid x:Name="AudioActions" Columns="2" Margin="0,0,-8,0"><Button x:Name="Health" Style="{StaticResource Action}"/><Button x:Name="Restore" Style="{StaticResource Action}"/><Button x:Name="Logs" Style="{StaticResource Action}"/><Button x:Name="Diagnostics" Style="{StaticResource Action}"/></UniformGrid>
     <TextBlock x:Name="HealthStatus" Foreground="#AAB8CD" FontSize="13" Margin="0,2,0,0" Style="{StaticResource Collapsible}"/>
     <TextBlock x:Name="ApplicationSection" Style="{StaticResource Section}"/>
     <UniformGrid x:Name="ApplicationActions" Columns="2" Margin="0,0,-8,0"><Button x:Name="About" Style="{StaticResource Action}"/></UniformGrid>
     <TextBlock x:Name="FolderLabel" Foreground="#AAB8CD" FontSize="13" Margin="0,8,0,5"/>
     <DockPanel><Button x:Name="OpenFolder" DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xED25;"/><Button x:Name="CopyFolder" DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE8C8;"/><TextBox x:Name="Location" IsReadOnly="True" Background="#141B26" Foreground="#C9D3E2" FlowDirection="LeftToRight" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/></DockPanel>
     <Border Height="1" Background="#303A4A" Margin="0,16,0,0"/>
     <TextBlock x:Name="UninstallSection" Style="{StaticResource Section}"/>
     <Button x:Name="Uninstall" Style="{StaticResource Danger}" Margin="0,3,0,6"/>
    </StackPanel></Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
 </Grid>
</Window>


